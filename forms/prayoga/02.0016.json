    "कक्षे": [
      {
        "src": "mahabharata",
        "ref": "2161",
        "text": "नक्षान् स कक्षे परिगृह्य वाससा ।। १ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2278",
        "text": "यथाग्निः सुमहानिद्धः कक्षे चरति सानिलः । तथा जज्वाल भीष्मोऽपि दिव्यान्यस्त्राण्युदीरयन् ।। ६७ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "741",
        "text": "तया चाप्यभवन्मिश्रो गर्भं चास्यादधे तदा । ववृधे स तदा गर्भः कक्षे कृष्णगतिर्यथा ।। ५६ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2146",
        "text": "उत्प्लुत्य तीर्थमासाद्य धौते शुक्ते च वाससी । शुद्धे चाच्छादयेत् कक्षे न कुर्यात् परिपाशके ।।"
      }
    ]
  }
}