    "स्थलानि": [
      {
        "src": "ramayanam",
        "ref": "2.80.8",
        "text": "अपरे वीरणस्तम्बान् बलिनो बलवत्तराः ।\nविधमन्ति स्म दुर्गाणि स्थलानि च ततस्ततः ॥"
      },
      {
        "src": "ramayanam",
        "ref": "6.66.16",
        "text": "ते स्थलानि तदा निम्नं विवर्णवदना भयात् ।\nऋक्षा वृक्षान् समारूढाः केचित् पर्वतमाश्रिताः ॥"
      },
      {
        "src": "mahabharata",
        "ref": "1194",
        "text": "स्थलानि निम्नानि च तत्र तत्र ।। ३ ।"
      }
    ],
    "स्थल": [
      {
        "src": "mahabharata",
        "ref": "1617",
        "text": "स्थल समझकर उसमें गिर पड़ते थे ।। ३३ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2025",
        "text": "सुशोभित बावलीको स्थल मानकर वह वस्त्रसहित जलमें गिर पड़ा ।। ६ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2294",
        "text": "तथा सम्भिन्नसर्वाङ्गं कूर्मं स्थल इवोद्धृतम् ।। २ ॥"
      },
      {
        "src": "bhagwatam",
        "ref": "1627",
        "text": "जलको स्थल समझकर वह उसमें गिर पडा॥ ३७॥"
      }
    ]
