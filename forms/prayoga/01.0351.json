      {
        "src": "mahabharata",
        "ref": "1079",
        "text": "धरतीपर लोट रहे हैं ।। ४९-५० ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2968",
        "text": "तुम्हारे जैसा राजा धूलमें सना हुआ लोट रहा है ।। १३ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "3176",
        "text": "शय्याओंपर सोते थे, वे ही आज धूलमें लोट रहे हैं ।। ३३ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "3182",
        "text": "वही आज यह धूलमें लोट रहा है। कालके इस उलट-फेरको तो देखो ।। ११ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "3190",
        "text": "हुआ तथा सुख भोगनेके ही योग्य था; परंतु आज धूलमें लोट रहा है ।। ५ ।।"
      },
      {
        "src": "bhagwatam",
        "ref": "1255",
        "text": "व्रजमें लोट आये॥ ४६॥ श्रीकृष्णके सिरपर मोरपंखका"
      },
      {
        "src": "bhagwatam",
        "ref": "1460",
        "text": "लोट आये॥ ६८॥ वहाँ पहुँचकर उन्होंने भगवान्‌"
      },
      {
        "src": "bhagwatam",
        "ref": "1466",
        "text": "लोट आये॥ ३६॥"
      },
      {
        "src": "bhagwatam",
        "ref": "319",
        "text": "लोट आये॥ १॥ इधर दितिको अपने पतिदेवके"
      },
      {
        "src": "bhagwatam",
        "ref": "610",
        "text": "लोट आयेगा 2॥ १६॥ क्या मैं उसे फिर इस आश्रमके"
      },
      {
        "src": "bhagwatam",
        "ref": "819",
