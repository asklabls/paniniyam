    "अगाधे": [
      {
        "src": "ramayanam",
        "ref": "4.23.10",
        "text": "अगाधे च निमग्नास्मि विपुले शोकसागरे ।\nअश्मसारमयं नूनमिदं मे हृदयं दृढम् ॥"
      },
      {
        "src": "mahabharata",
        "ref": "1312",
        "text": "घातयित्वा महावीर्यं पितरं लोकधार्मिकम् । अगाधे सलिले मग्नां नावं दृष्ट्वेव पारगाः ।। ५६ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "1999",
        "text": "ते हन्यमानाः पार्थेन भीष्मं शान्तनवं ययुः । अगाधे मज्जमानानां भीष्मः पोतोऽभवत् तदा ।। ४५ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2235",
        "text": "अगाधे मज्जतस्तस्य द्वीपो भीष्मोऽभवत् तदा ।। ४६ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2257",
        "text": "अगाधे मज्जतां तेषां द्वीपः कर्णोऽभवत्तदा ।। ४७ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2740",
        "text": "तद्भयादपसर्पन् वै तस्मिन् कूपे पपात ह । अगाधे सुमहाघोरे सर्वभूतभयंकरे ।। २६ ।।"
      }
    ]
  }
}