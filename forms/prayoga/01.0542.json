  "forms": {
    "जम": [
      {
        "src": "mahabharata",
        "ref": "1462",
        "text": "लिये लगी हुई दर्शकोंकी दृष्टि जम न जाती हो ।। १६ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "461",
        "text": "धूल जम गयी थी ।। ११५ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "996",
        "text": "उस समय वीरोंके सिंहनाद तथा वाहनोंके नाना प्रकारके शब्द सब ओर गूँज उठे। बिना बादलके ही आकाशसे रक्तकी वर्षा होने लगी, जिसकी कीच जम गयी ।। २८ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "1004",
        "text": "कीच जम जायगी ।। २७ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "1817",
        "text": "कीचड़ जम गयी थी। वहाँकी भूमिमें जाना असम्भव हो गया था ।। २७ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "179",
        "text": "मांसकी कीच जम गयी थी ।। ५३ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "816",
        "text": "मांस और रक्तकी कीच जम गयी थी ।। ४५-४६ ||"
      },
      {
        "src": "mahabharata",
        "ref": "952",
        "text": "थे। उनके पंख और अग्रभागोंपर अधिक रक्त जम गया था ।। २८ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "2046",
        "text": "और इसपर रक्तकी कीच जम गयी है ।। ३३ ||"
      },
      {
        "src": "mahabharata",
        "ref": "2224",
        "text": "असम्भव हो गया। रक्त और मांसकी कीच जम गयी ।। ४३३३ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "3179",
        "text": "फिरना असम्भव हो गया है। यहाँ मांस और रक्तकी कीच जम गयी है ।। ५६ ।।"
      },
      {
        "src": "mahabharata",
        "ref": "1678",
        "text": "विश्वास जम जानेके कारण वे दोनों पक्षी वहाँ बड़े सुखसे रहने लगे ।। २२ ।।"
      }
    ]
  }
}